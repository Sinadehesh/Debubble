<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget, short: your room, and today's four as a strip of icons that tick themselves.
    Each one still opens its task. See widget_room.xml for the tall version.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/widget_room"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_room_description"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_room_preview" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_row_0"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_button">

            <ImageView
                android:id="@+id/widget_icon_0"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_check_0"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_row_1"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_button">

            <ImageView
                android:id="@+id/widget_icon_1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_check_1"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_row_2"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_button">

            <ImageView
                android:id="@+id/widget_icon_2"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_check_2"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/widget_row_3"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_button">

            <ImageView
                android:id="@+id/widget_icon_3"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/widget_check_3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="3dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:maxLines="1"
            android:text="@string/widget_count_default"
            android:textColor="@color/ink_gold"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>

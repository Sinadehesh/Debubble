<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The room's cream wall, painted before Compose takes over so there is no flash of
         another colour on launch, with dark status and navigation icons to read on it. -->
    <style name="Theme.DeBubble" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/void_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>

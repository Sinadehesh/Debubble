<?xml version="1.0" encoding="utf-8"?>
<!--
    These duplicate the Ink tokens in ui/theme/Theme.kt. The widget is drawn with RemoteViews,
    which cannot see Compose colours, so the two have to be kept in step by hand
    (tools/check_palette.py reads Theme.kt; the inks here are the same values). The widget sits
    on a stranger's wallpaper and is the one surface in the product where a legibility mistake
    is permanently visible, so it is the same cream card with a plum edge as everything else.
-->
<resources>
    <!-- The wall, before Compose draws its diamonds: no dark flash on launch. -->

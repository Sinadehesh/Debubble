<?xml version="1.0" encoding="utf-8"?>
<!--
    These duplicate the Ink tokens in ui/theme/Theme.kt. The widget is drawn with RemoteViews,
    which cannot see Compose colours, so the two have to be kept in step by hand. Anything
    added here must match Theme.kt exactly, including the measured contrast ratios in its
    comments — the widget sits on a stranger's wallpaper and is the one surface in the product
    where a legibility mistake is permanently visible.
-->
<resources>
    <color name="void_ground">#FF000000</color>
    <color name="ic_launcher_background">#FF000000</color>

    <color name="ink_void">#FF0E1116</color>
    <color name="ink_surface">#FF181D26</color>
    <color name="ink_surface_high">#FF232B38</color>
    <color name="ink_border">#FF6B7789</color>
    <color name="ink_primary">#FFF5F7FA</color>
    <color name="ink_secondary">#FFB4BECD</color>
    <color name="ink_muted">#FF8593A6</color>
    <color name="ink_access">#FF4DA3FF</color>
    <color name="ink_activity">#FF3DDC97</color>
    <color name="ink_social">#FFFF6B81</color>
    <color name="ink_ember">#FFFFB020</color>
    <color name="ink_gold">#FFFFC94D</color>
</resources>

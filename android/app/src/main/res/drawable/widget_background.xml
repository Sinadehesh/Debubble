<?xml version="1.0" encoding="utf-8"?>
<!-- The same panel the app uses: rounded, filled, with a visible 1dp boundary. The border is
     not decoration — on a light wallpaper the fill alone leaves no edge at all. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/ink_surface" />
    <stroke android:width="1dp" android:color="@color/ink_border" />
    <corners android:radius="20dp" />
</shape>

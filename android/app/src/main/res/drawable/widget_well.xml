<?xml version="1.0" encoding="utf-8"?>
<!-- A sunken well: the wall shade with a plum edge, flat. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the edge -->
    <item android:left="6dp" android:top="0dp" android:right="6dp" android:bottom="0dp">
        <shape android:shape="rectangle"><solid android:color="@color/ink_border" /></shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle"><solid android:color="@color/ink_border" /></shape>
    </item>
    <item android:left="0dp" android:top="6dp" android:right="0dp" android:bottom="6dp">
        <shape android:shape="rectangle"><solid android:color="@color/ink_border" /></shape>
    </item>
    <!-- the face -->
    <item android:left="8dp" android:top="2dp" android:right="8dp" android:bottom="2dp">
        <shape android:shape="rectangle"><solid android:color="@color/ink_well" /></shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle"><solid android:color="@color/ink_well" /></shape>
    </item>
    <item android:left="2dp" android:top="8dp" android:right="2dp" android:bottom="8dp">
        <shape android:shape="rectangle"><solid android:color="@color/ink_well" /></shape>
    </item>
</layer-list>
